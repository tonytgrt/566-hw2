{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "0aa07f5ea25c414298ae81fb542a6173",
    "m_Title": "Part 4: survival horror finish",
    "m_Content": "Off-centre slate vignette (the art's backdrop darkens toward the top-right) whose edge bleeds in like a watercolour wash and flickers like a failing torch; a split-tone grade (cool darks, warm highlights); and fine film grain. Runs after the outline pass.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1180.0,
