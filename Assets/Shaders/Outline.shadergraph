{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "79577a4f2811431886bb74d8451a8cc7",
    "m_Title": "Buffers",
    "m_Content": "Depth: the Scene Depth node (which also makes Shader Graph declare the camera depth texture) plus GetDepth taps in OutlineHelp.hlsl. Normals: _NormalsBuffer, the render texture Normal Feature draws view-space normals into (the ground's No Normal layer is left out).",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1480.0,
        "y": 0.0,
        "width": 320.0,
        "height": 130.0
    },
    "m_Group": {
        "m_Id": "26003b5698bd45bd9a3e498c84994361"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "1acbfeca0a764002a003012ef3c5fce0",
    "m_Title": "Lines",
    "m_Content": "Edge Filter 0 Roberts Cross, 1 Sobel, 2 Laplacian (on 1/depth, so floors at grazing angles stay clean). Silhouettes come from depth and boil every Floor(Time x Boil Rate) step; creases come from normals and hold still. Lines take the front object's colour x Line Tint, mixed toward Line Color.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -380.0,
        "y": 100.0,
        "width": 330.0,
        "height": 150.0
    },
    "m_Group": {
        "m_Id": "647139dbb86f40db96db499455ae20e0"
    }
}

