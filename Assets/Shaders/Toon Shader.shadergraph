{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "c1f5a7f877ec4841ada003e50e5c2abc",
    "m_Title": "Interesting shadow: watercolour wash",
    "m_Content": "Shadows are a translucent glaze of Shadow over the lit colour. Watercolor Wash.png (mesh UV x Shadow Scale) sets the pigment density (Wash Strength). The form-shadow edge is broken up by world-space noise, so it doesn't follow the UV layout, and pigment pools into a darker rim inside it (Edge Darkening). Cast shadows skip the bands and keep their gradual fade. Band Softness 0 = the lab's hard bands.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1360.0,
        "y": 400.0,
        "width": 340.0,
        "height": 170.0
    },
    "m_Group": {
        "m_Id": "286ce97b01784aa089bd2bf5cdbe45df"
    }
}

