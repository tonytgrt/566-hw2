{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "6b4e647f78f044759543169d351181ef",
    "m_Title": "Ported from Lab 3",
    "m_Content": "Same main-light setup as the lab toon shader (Diffuse = N.L x distance x shadow attenuation). Fix: the Normal Vector is now World space; the lab used Object space, which is only correct for unrotated meshes. WatercolorShadow replaces the raw shadow: averaged over Soft Shadow Radius and jittered by world noise, so cast shadows get feathered, irregular wash edges.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2380.0,
        "y": 220.0,
        "width": 320.0,
        "height": 150.0
    },
    "m_Group": {
        "m_Id": "48a33cf63d56495a8adcfed3dcc6d8e5"
    }
}

