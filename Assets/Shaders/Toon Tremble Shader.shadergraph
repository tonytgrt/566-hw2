{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "9c3ab713a46b48b2a5dcec130d3df4da",
    "m_Title": "Ported from Lab 3",
    "m_Content": "Same main-light setup as the lab toon shader, but the shadow is kept apart: Diffuse = N.L x distance attenuation drives the toon bands, and WatercolorShadow is laid over them as a continuous glaze. Fix: the Normal Vector is now World space; the lab used Object space, which is only correct for unrotated meshes. WatercolorShadow replaces the raw shadow: it finds how far the caster is, then softens (Penumbra Growth) and fades out (Shadow Fade Distance) the shadow with that distance.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2380.0,
        "y": 260.0,
        "width": 320.0,
        "height": 170.0
    },
    "m_Group": {
        "m_Id": "87691257745744daaa26b728933dad8a"
    }
}

