{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "484a6a2fa8164495b603ea0fc8606134",
    "m_Title": "Interesting shadow",
    "m_Content": "Gloom Hatch.png is sampled with mesh UV x Shadow Scale instead of screen position, so the strokes stick to the surface. Shadow band: paper = Shadow, strokes = Shadow x Hatch Color. Hatch Spread lets strokes poke past the terminator. Band Softness 0 = the lab's hard bands.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1360.0,
