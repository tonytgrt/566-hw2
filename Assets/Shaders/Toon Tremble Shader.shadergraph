{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "8ac5a8b7a778425eadb06dec8203af90",
    "m_Title": "Special shader: tremble",
    "m_Content": "Option 2 vertex animation, after Grace's shake marks. Floor(Time x Tremble Rate) steps the motion like hand-drawn animation on twos: each step the object hops sideways (Shake) and its surface re-boils along the normal (Boil).",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1100.0,
