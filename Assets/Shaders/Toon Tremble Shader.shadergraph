{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "b3b15621be704639849069604004b3e5",
    "m_Title": "Interesting shadow: watercolour wash",
    "m_Content": "Shadows are a translucent glaze of Shadow over the lit colour. Watercolor Wash.png (mesh UV x Shadow Scale) sets the pigment density (Wash Strength). The edge is broken up by world-space noise, so it doesn't follow the UV layout, and pigment pools into a darker rim inside it (Edge Darkening). Band Softness 0 = the lab's hard bands.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1360.0,
        "y": 400.0,
        "width": 340.0,
        "height": 160.0
    },
    "m_Group": {
        "m_Id": "9b7945eda9c04daa8a38465ded8571a3"
    }
}

